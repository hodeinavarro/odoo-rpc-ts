{
  "name": "odoo-rpc-ts",
  "version": "0.0.0",
  "private": true,
  "description": "A modern, Effect-native, strongly-typed Odoo RPC client for TypeScript.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "harness": "node harness/cli.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@effect/platform": "^0.96.2",
    "@effect/platform-node": "^0.107.0",
    "@effect/vitest": "^0.29.0",
    "@types/node": "^26.1.1",
    "effect": "^3.21.4",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@effect/platform": "^0.96.0",
    "effect": "^3.21.0"
  }
}
