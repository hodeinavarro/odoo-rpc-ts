{
  "name": "@hodeinavarro/odoo-rpc-ts",
  "version": "0.4.0",
  "description": "Effect-native, strongly-typed Odoo RPC client for TypeScript — JSON-RPC, JSON-2, and cookie-session transports for Odoo 16–19 with a tagged-error taxonomy.",
  "keywords": [
    "api-client",
    "effect",
    "effect-ts",
    "erp",
    "json-rpc",
    "odoo",
    "rpc",
    "typescript"
  ],
  "homepage": "https://github.com/hodeinavarro/odoo-rpc-ts#readme",
  "bugs": {
    "url": "https://github.com/hodeinavarro/odoo-rpc-ts/issues"
  },
  "license": "MIT",
  "author": "Hodei Navarro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodeinavarro/odoo-rpc-ts.git"
  },
  "files": [
    "dist",
    "src",
    "docs/protocol-verification.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/fix-dts-extensions.mjs",
    "prepack": "pnpm build",
    "check": "tsc --noEmit",
    "harness": "node harness/cli.mjs",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "oxlint",
    "fmt": "oxfmt"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/node": "^26.1.1",
    "effect": "4.0.0-rc.112",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "packageManager": "pnpm@11.16.0"
}
